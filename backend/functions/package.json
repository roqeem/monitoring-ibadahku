{
  "name": "functions",
  "engines": {
    "node": "18"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "firebase emulators:start --only functions,firestore",
    "test": "mocha --require ts-node/register \"test/*.test.ts\"",
    "test:integration": "npm run build && firebase emulators:exec --project monitor-ibadahku-dev --only firestore,auth,functions \"npx tsx --test test/integration/contract.test.ts\"",
    "lint": "eslint src test"
  },
  "type": "module",
  "dependencies": {
    "firebase-admin": "^12.5.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.0",
    "@types/sinon": "^17.0.3",
    "eslint": "^10.8.1",
    "firebase-functions-test": "^3.4.0",
    "mocha": "^10.2.0",
    "prettier": "^3.9.6",
    "sinon": "^22.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "5.4.5"
  }
}
